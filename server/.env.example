# Copie para .env e ajuste. Valores abaixo são apenas para desenvolvimento local.
PORT=3100
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sogester

JWT_SECRET=troque-isto-em-producao
JWT_EXPIRES_IN=8h

# Token exigido por POST /api/v1/setup/entity-admin. Deixe vazio para desativar.
SETUP_TOKEN=dev-setup-token

SEED_SUPERADMIN_EMAIL=admin@sogester.local
SEED_SUPERADMIN_PASSWORD=Admin@12345

# Assina os códigos de autorização digital. Gere um valor aleatório longo em produção.
AUTHORIZATION_SECRET=troque-isto-em-producao
# Dias para liquidar após saída antecipada (perecíveis).
PAYMENT_COMMITMENT_DAYS=3

# URL pública do frontend (usada nos links dos e-mails).
APP_URL=http://localhost:5173
# E-mail (SMTP). Sem SMTP_HOST, as notificações ficam só dentro da plataforma.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sogester <no-reply@sogester.local>
