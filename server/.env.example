# Copie para .env e preencha. Nunca coloque o .env no git: os segredos ficam só no servidor.
PORT=3100
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sogester

# Gere valores aleatórios longos (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Token da inicialização única (/setup cria o super administrador e fecha para sempre).
# Depois da inicialização, apague-o: a plataforma não volta a abrir o setup.
SETUP_TOKEN=

# Assina os códigos de autorização digital. Gere um valor aleatório longo em produção.
AUTHORIZATION_SECRET=
# Dias para liquidar após saída antecipada (perecíveis).
PAYMENT_COMMITMENT_DAYS=3

# URL pública do frontend (usada nos links dos e-mails).
APP_URL=http://localhost:5173
# E-mail (SMTP). Sem SMTP_HOST, as notificações ficam só dentro da plataforma.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sogester <no-reply@sogester.local>
